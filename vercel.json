{
  "services": {
    "web": {
      "root": "frontend"
    },
    "api": {
      "root": "backend",
      "entrypoint": "index.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}